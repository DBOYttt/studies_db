# Build from the repo root: podman build -f apps/bot/Containerfile .
# node:22-bookworm-slim, pinned by its multi-arch index digest (bump on purpose).
FROM docker.io/library/node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
ENV NODE_ENV=production
RUN corepack enable
WORKDIR /app
COPY . .
# Production dependencies only (tsx is one: the bot runs its TS source).
RUN pnpm install --frozen-lockfile --prod --filter @studies/bot...

# Runtime: only the bot, packages/db and their node_modules; no build tooling.
FROM docker.io/library/node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/apps/bot ./apps/bot
WORKDIR /app/apps/bot
# Not root: the bot writes STORAGE_DIR/originals and tmp and deletes from
# uploads, which the migrate service hands to uid 1000 (node).
USER node
CMD ["node", "--import", "tsx", "src/index.ts"]
