{
  "name": "@studies/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "register": "node --env-file-if-exists=../../.env --import tsx src/register-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@studies/db": "workspace:*",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
