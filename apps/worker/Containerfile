# Build from the repo root: podman build -f apps/worker/Containerfile .
FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libreoffice-writer libreoffice-impress libreoffice-calc poppler-utils fonts-dejavu fonts-liberation fonts-crosextra-carlito fonts-crosextra-caladea \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
RUN corepack enable
WORKDIR /app
COPY . .
# tsx is a devDependency used at runtime, so install the full dependency set.
RUN pnpm install --frozen-lockfile --prod=false --filter @studies/worker...
WORKDIR /app/apps/worker
# Not root: soffice/pdftotext read untrusted documents. The worker writes only
# STORAGE_DIR/previews, which the migrate service hands to uid 1000 (node).
USER node
CMD ["node", "--import", "tsx", "src/index.ts"]
