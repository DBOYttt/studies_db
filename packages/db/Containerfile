# Migration job. Build from the repo root: podman build -f packages/db/Containerfile .
# node:22-bookworm-slim, pinned by its multi-arch index digest (bump on purpose).
FROM docker.io/library/node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ENV NODE_ENV=production
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --prod=false --filter @studies/db...
WORKDIR /app/packages/db
CMD ["node", "--import", "tsx", "src/cli/migrate.ts"]
