DATABASE_URL=mysql://root:devroot@127.0.0.1:3307/studies
DATABASE_ADMIN_URL=mysql://root:devroot@127.0.0.1:3307/studies
DB_RO_PASSWORD=change-me-ro
DATABASE_RO_URL=mysql://studies_ro:change-me-ro@127.0.0.1:3307/studies
DB_RW_PASSWORD=change-me-rw
DATABASE_RW_URL=mysql://studies_rw:change-me-rw@127.0.0.1:3307/studies
TEST_DATABASE_URL=mysql://root:devroot@127.0.0.1:3307/studies_test
STORAGE_DIR=./storage
MARIADB_ROOT_PASSWORD=devroot

# Discord bot (placeholders - fill in from the Developer Portal)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000
# Admin role name (optional). The first /setup adopts the role with this name (or
# creates it) and pins its id in the DB; admin commands check that id, not the name.
# ADMIN_ROLE_NAME=Studies Admin
WEB_BASE_URL=http://localhost:3000

# Worker (optional - defaults shown)
# WORKER_CONCURRENCY=2
# SOFFICE_BIN=soffice
# PDFTOTEXT_BIN=pdftotext

# Plan zajęć (UniTime iCalendar export URL — secret, do not commit)
# UNITIME_ICAL_URL=
# Optional second feed: UniTime exam timetable; every entry is imported as an exam.
# Used only together with UNITIME_ICAL_URL (same secret rules).
# UNITIME_EXAM_ICAL_URL=
# Hosts students may import My groups from (comma-separated; default plan.agh.edu.pl).
# UNITIME_IMPORT_HOSTS=plan.agh.edu.pl

# Production / Compose: see .env.prod.example (container-network URLs, TUNNEL_TOKEN).
