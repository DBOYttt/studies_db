{
  "name": "studies-db",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "dev:bot": "pnpm --filter @studies/bot dev",
    "dev:worker": "pnpm --filter @studies/worker dev",
    "db:up": "sh scripts/db-up.sh",
    "db:migrate": "pnpm --filter @studies/db migrate",
    "db:seed": "pnpm --filter @studies/db seed",
    "db:login": "pnpm --filter @studies/db run login-link",
    "dev:web": "pnpm --filter @studies/web dev",
    "qa:sandbox": "pnpm --filter @studies/db qa sandbox",
    "qa:login": "pnpm --filter @studies/db qa login",
    "qa:serve": "pnpm --filter @studies/web qa:serve",
    "check:lang": "node scripts/check-ui-language.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.6.4"
  }
}
