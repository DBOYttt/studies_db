# SECRETS MUST BE URL-SAFE: generate with `openssl rand -hex 32`. They are
# embedded in mysql:// URLs and compose interpolation; characters like @ / # ? % : $ \ ; & space break them.
# Copy to .env on the server (compose reads it for interpolation and env_file).
# Container-network values: the DB host is `mariadb:3306`.
MARIADB_ROOT_PASSWORD=<hex-root>
DB_RO_PASSWORD=<hex-ro>
# migrate gets DATABASE_ADMIN_URL from compose.yaml (root @ mariadb).
DATABASE_URL=mysql://root:<hex-root>@mariadb:3306/studies
DATABASE_RO_URL=mysql://studies_ro:<hex-ro>@mariadb:3306/studies
# STORAGE_DIR is forced to /data/storage by compose (must be absolute in production).

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Admin role name (optional; /setup creates it if missing)
# ADMIN_ROLE_NAME=Studies Admin
WEB_BASE_URL=https://studies.example.com

# Cloudflare Tunnel token (profile "prod")
TUNNEL_TOKEN=

# UniTime iCalendar export URL (SECRET: never commit a real value)
UNITIME_ICAL_URL=

# WORKER_CONCURRENCY=2
# Used by scripts/backup.sh
# BACKUP_DIR=/srv/backups/studies
